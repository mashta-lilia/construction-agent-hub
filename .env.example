# --- Postgres ---
POSTGRES_USER=reconstruction_hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconstruction_hub

# --- Redis ---
REDIS_PASSWORD=

# --- Backend / JWT (CLAUDE.md §10 — access 15-30min, refresh longer) ---
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_EXPIRE_MINUTES=20
JWT_REFRESH_EXPIRE_MINUTES=10080

# --- CORS ---
# Includes :5173 for `npm run dev` (Vite) — the nginx-served build only
# needs :80/:443, but hitting the containerised backend directly from Vite's
# dev server needs its own origin allowed, or preflights fail.
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173

# --- Dev-only: Tortoise schema auto-generation on backend startup ---
# Absent or false in staging/prod (compose defaults it to false).
BACKEND_DEBUG=true

# --- AI (OpenRouter, CLAUDE.md §7.4) ---
OPENROUTER_API_KEY=

# --- Mail (self-hosted SMTP/IMAP, CLAUDE.md §7.2) ---
SMTP_HOST=mail
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed account generated inside the mail container at start (see
# mail/seed-account.sh) — Dovecot won't start with zero accounts. Not a real
# mailbox; change before anything real depends on this service.
MAIL_SEED_ACCOUNT=placeholder@reconstruction-hub.local
MAIL_SEED_PASSWORD=change-me-placeholder-password
