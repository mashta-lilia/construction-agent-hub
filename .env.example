# --- Postgres ---
POSTGRES_USER=reconstruction_hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconstruction_hub

# --- Redis ---
# (no auth in this skeleton; add REDIS_PASSWORD + update REDIS_URL when hardening)

# --- Backend / JWT ---
JWT_SECRET=change-me-to-a-random-secret

# --- AI (OpenRouter, CLAUDE.md §7.4) ---
OPENROUTER_API_KEY=

# --- Mail (self-hosted SMTP/IMAP, CLAUDE.md §7.2) ---
SMTP_HOST=mail
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed account generated inside the mail container at start (see
# mail/seed-account.sh) — Dovecot won't start with zero accounts. Not a real
# mailbox; change before anything real depends on this service.
MAIL_SEED_ACCOUNT=placeholder@reconstruction-hub.local
MAIL_SEED_PASSWORD=change-me-placeholder-password
