# --- Postgres ---
POSTGRES_USER=reconstruction_hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconstruction_hub

# docker-compose.yml builds these for the backend/worker containers from the
# three vars above, so the values here are only used for running the backend
# directly on the host (`uv run uvicorn main:app`) without docker-compose.
POSTGRES_DSN=postgres://reconstruction_hub:change-me@localhost:5432/reconstruction_hub
REDIS_URL=redis://localhost:6379/0

# --- Backend / JWT ---
JWT_SECRET=change-me-to-a-random-secret

# --- AI (OpenRouter, CLAUDE.md §7.4) ---
OPENROUTER_API_KEY=

# --- Mail (self-hosted SMTP/IMAP, CLAUDE.md §7.2) ---
SMTP_HOST=mail
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Seed account generated inside the mail container at start (see
# mail/seed-account.sh) — Dovecot won't start with zero accounts. Not a real
# mailbox; change before anything real depends on this service.
MAIL_SEED_ACCOUNT=placeholder@reconstruction-hub.local
MAIL_SEED_PASSWORD=change-me-placeholder-password
