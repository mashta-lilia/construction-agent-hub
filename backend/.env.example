# For standalone (non-compose) local runs: cp .env.example .env and fill in.
# Under docker-compose, these are injected via the root .env + compose's
# environment: blocks instead — see the repo root .env.example.

# database
DB_USER=reconstruction_hub
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reconstruction_hub

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# cors
CONF_ORIGINS=http://localhost,http://localhost:5173

# dev-only: enables Tortoise schema auto-generation on startup.
# Leave unset/false in staging and production.
CONF_DEBUG=true

# jwt (CLAUDE.md §10)
JWT_SECRET=local-dev-only-generate-a-real-secret-before-any-real-use
JWT_ACCESS_EXPIRE_MINUTES=20
JWT_REFRESH_EXPIRE_MINUTES=10080

# ai (OpenRouter, CLAUDE.md §7.4)
OPENROUTER_API_KEY=

# mail (self-hosted SMTP, CLAUDE.md §7.2)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
