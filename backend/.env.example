# For standalone (non-compose) local runs: cp .env.example .env and fill in.
# Under docker-compose, these are injected via the root .env + compose's
# environment: blocks instead — see the repo root .env.example.

# database
DB_USER=reconstruction_hub
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reconstruction_hub

# redis
# The password is not optional: docker-compose starts Redis with
# `--requirepass ${REDIS_PASSWORD}`, so a blank value here authenticates as
# nobody and /ready reports Redis as down. Keep it in step with the root
# .env.example.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# cors
CONF_ORIGINS=http://localhost,http://localhost:5173

# dev-only: enables Tortoise schema auto-generation on startup.
# Leave unset/false in staging and production.
CONF_DEBUG=true

# jwt (CLAUDE.md §10)
# Replace this line after `cp .env.example .env` — the value below is on the
# placeholder blocklist in app/utils/classes/config.py, so the app refuses to
# import until it is a real secret. That refusal is deliberate (the committed
# value is public, and HS256 with a public secret is forgeable), which is why
# a plain copy of this file is not a runnable config:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=local-dev-only-generate-a-real-secret-before-any-real-use
JWT_ACCESS_EXPIRE_MINUTES=20
JWT_REFRESH_EXPIRE_MINUTES=10080

# ai (OpenRouter, CLAUDE.md §7.4)
OPENROUTER_API_KEY=

# mail (self-hosted SMTP, CLAUDE.md §7.2)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
